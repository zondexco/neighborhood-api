# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10

# Supabase Configuration
SUPABASE_URL=https://db_url.supabase.co
SUPABASE_ANON_KEY=sb_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# PostgreSQL (Supabase)
DB_HOST=db.url.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=postgres
DB_SSLMODE=require
DB_MAX_CONN=25
DB_MIN_CONN=5
DB_CONN_TIMEOUT=30
DB_DISABLE_PREPARED_STATEMENTS=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_minimum_32_chars
JWT_EXPIRATION=86400
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production
JWT_REFRESH_EXPIRATION=604800

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://napp.cris.ac,http://localhost:3000,http://localhost:8081,http://localhost:*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ENABLE_FILE=true
LOG_FILE_PATH=logs/neighborhood-api.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=14
LOG_COMPRESS=true
LOG_ALSO_STDOUT=true

# Application
APP_NAME=neighborhood-api
APP_VERSION=0.2.0
